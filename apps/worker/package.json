{
  "name": "@jobflow/worker",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS BullMQ consumer: CSV streaming, batching, upserts, retries and checkpoints. See docs/tickets/EPIC-04-worker.md.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
