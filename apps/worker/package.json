    "test:unit": "jest",
    "test:integration": "jest -c jest.integration.config.js"
  },
  "dependencies": {
    "@jobflow/contracts": "workspace:*",
    "@jobflow/database": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "bullmq": "^6.3.15",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^10.18.0",
    "@testcontainers/redis": "^10.18.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.10.1",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "tsx": "^4.23.15",
    "typescript": "5.7.2"
  }
