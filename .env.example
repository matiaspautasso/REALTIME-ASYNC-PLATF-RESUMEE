# ----------------------------------------------------------------------------
# JobFlow environment template. Copy to `.env` and adjust for local runs.
# `docker compose up --build` reads these values.
# ----------------------------------------------------------------------------

# PostgreSQL — source of truth for products, imports, errors and attempts.
POSTGRES_USER=jobflow
POSTGRES_PASSWORD=jobflow
POSTGRES_DB=jobflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jobflow:jobflow@localhost:5432/jobflow?schema=public

# Redis — BullMQ broker and queue storage.
REDIS_HOST=localhost
REDIS_PORT=6379

# API (NestJS REST + WebSocket gateway).
API_PORT=3000

# Web (React + Vite).
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# Worker (independent BullMQ consumer).
# Concurrent jobs processed per worker instance.
WORKER_CONCURRENCY=2
# Rows processed and committed per transaction.
IMPORT_BATCH_SIZE=100
# Total BullMQ attempts (1 initial + retries) for transient failures.
IMPORT_MAX_ATTEMPTS=3

# Shared upload volume. The API writes the CSV here; the worker reads it by
# path. See ADR-0003 (CSV files are NOT stored in Redis).
UPLOAD_DIR=./data/uploads
