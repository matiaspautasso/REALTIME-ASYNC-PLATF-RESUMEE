// JobFlow data model. PostgreSQL is the source of truth (see docs/architecture.md
// and docs/adr). Terms match CONTEXT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lifecycle of an Import. Mirrors ImportStatus in @jobflow/contracts.
enum ImportStatus {
  QUEUED
  PROCESSING
  RETRYING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

/// Outcome of a single technical Job Attempt.
enum JobAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// A sellable item identified by its SKU. Upserted by SKU, which is what makes
/// re-importing a file idempotent (ADR-0005).
model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  price     Decimal  @db.Decimal(12, 2)
  stock     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

/// One execution of ingesting a CSV file. Owns the file reference, the running
/// counters and the terminal outcome.
model ImportJob {
  id        String       @id @default(cuid())
  fileName  String
  filePath  String
  status    ImportStatus @default(QUEUED)
  totalRows Int          @default(0)

  processedRows Int @default(0)
  successRows   Int @default(0)
  failedRows    Int @default(0)
  progress      Int @default(0)

  /// The Checkpoint: how many Batches are already committed. A retry resumes
  /// after this count so counters are never double-counted (ADR-0005).
  committedBatches Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  errors   ImportError[]
  attempts JobAttempt[]
  outbox   Outbox[]

  @@index([status])
  @@map("import_jobs")
}

/// A single Row rejected for violating a business rule (a Data Error). Never a
/// technical failure of the worker.
model ImportError {
  id          String   @id @default(cuid())
  importJobId String
  rowNumber   Int
  /// One of @jobflow/contracts ImportErrorCode (stored as text to stay in sync
  /// with the shared enum without a second DB enum to migrate).
  errorCode   String
  message     String
  createdAt   DateTime @default(now())

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("import_errors")
}

/// One technical execution of an Import by a worker. Several may accumulate
/// across retries; each records why it failed, if it did.
model JobAttempt {
  id            String           @id @default(cuid())
  importJobId   String
  attemptNumber Int
  status        JobAttemptStatus @default(RUNNING)
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  errorMessage  String?

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, attemptNumber])
  @@index([importJobId])
  @@map("job_attempts")
}

/// Transactional outbox: the intent to enqueue a job, written in the SAME
/// transaction that persists the ImportJob, then published by the relay
/// (ADR-0004). `publishedAt` is null until the relay enqueues it.
model Outbox {
  id          String    @id @default(cuid())
  importJobId String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@map("outbox")
}
